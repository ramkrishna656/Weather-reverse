# Open-Meteo API Configuration
# Non-commercial / open-source use does not require an API key (leave empty to use the free tier).
# For commercial subscription accounts, enter your API key here:
OPEN_METEO_API_KEY=

# Server Port
PORT=4000

# Optional URL overrides (automatically routed to customer endpoints if an API key is provided):
# OPEN_METEO_FORECAST_URL=https://customer-api.open-meteo.com/v1/forecast
# OPEN_METEO_GEOCODE_URL=https://customer-geocoding-api.open-meteo.com/v1/search

